GEMINI_API_KEY=
# The exact public origin. Use this callback in Google Cloud:
# http://localhost:3000/api/auth/google/callback
ACCORD_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A base64-encoded 32-byte key. Required for cloud storage.
ACCORD_ENCRYPTION_KEY=
# Server-only. Do not add NEXT_PUBLIC_ to either variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local recording tests only. Refused on non-loopback origins.
ACCORD_LOCAL_MODE=false
# Optional directory for private local data. Cloud mode uses Supabase.
# ACCORD_DATA_DIR=.accord
# Optional separate worker. Run npm run capture:worker when true.
ACCORD_EXTERNAL_WORKER=false
# Optional installed FFmpeg binary for the target operating system.
# FFMPEG_PATH=/usr/bin/ffmpeg

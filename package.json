{
  "name": "accord-meeting-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-meeting-features.mjs",
    "test:capture": "node --conditions=react-server --import tsx --test scripts/test-capture.ts",
    "test:capture:live": "node --conditions=react-server --env-file=.env --import tsx scripts/test-capture-live.ts",
    "test:capture:http": "node --import tsx scripts/test-capture-http.ts",
    "test:extension": "node --test scripts/test-extension.mjs",
    "test:google": "node --conditions=react-server --import tsx --test scripts/test-google.ts",
    "test:cloud:live": "node --conditions=react-server --env-file=.env --import tsx scripts/test-cloud-live.ts",
    "capture:worker": "node --conditions=react-server --env-file=.env --import tsx scripts/capture-worker.ts",
    "extension:pack": "python3 scripts/package-extension.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/genai": "2.27.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "ffmpeg-static": "5.3.0",
    "google-auth-library": "11.1.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
